#!/usr/bin/env ruby
# frozen_string_literal: true

# yt_dlp — download YouTube videos to ~/Downloads/youtube_videos/
#
# Usage: ruby_yt_dlp.rb [options] <url>
#     -f, --format [FMT]               Video format (default: bestvideo+bestaudio)
#     -o, --output-dir [DIR]           Output directory (default:/home/nisidabay/Downloads/youtube_videos)
#     -h, --help                       Show this help

require 'optparse'

YTDLP  = 'yt-dlp'
NOTIFY = 'notify-send'
REQUIREMENTS = [YTDLP, NOTIFY]
OUTDIR = File.expand_path('~/Downloads/youtube_videos')

options = { format: 'bestvideo+bestaudio', output_dir: OUTDIR }
OptionParser.new do |opts|
  opts.banner = "Usage: #{File.basename($0)} [options] <url>"
  opts.on('-f', '--format [FMT]', "Video format (default: #{options[:format]})") { |f| options[:format] = f }
  opts.on('-o', '--output-dir [DIR]', "Output directory (default:#{options[:output_dir]})") do |o|
    options[:output_dir] = File.expand_path(o)
  end
  opts.on('-h', '--help', 'Show this help') do
    puts opts
    exit
  end
end.parse!

abort "Usage: #{File.basename($0)} <url>" if ARGV.empty?

REQUIREMENTS.each do |req|
  abort "Error: #{req} not found. Install with: pacman -S yt-dlp" unless system("command -v #{req} > /dev/null 2>&1")
end

url = ARGV[0]
Dir.mkdir(options[:output_dir]) unless Dir.exist?(options[:output_dir])

name = '%(title)s.%(ext)s'
out  = File.join(options[:output_dir], name)

puts "Downloading: #{url}"
puts "Output:      #{options[:output_dir]}/#{name}"

system(YTDLP, '-o', out, '-f', options[:format], url) or abort 'Download failed.'
system(NOTIFY, '📥 Ruby downloader', '\tDownload completed')
puts 'Done.'
