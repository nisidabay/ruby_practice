#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'yaml'
require 'json'
require 'fileutils'

class Kittycmd
  CONFIG_FILE = File.expand_path('~/.config/kitty/kitty.conf')
  OUTPUT_DIR = File.expand_path('~/.config/kitty')

  KITTY_ACTIONS = %w[
    copy_to_clipboard paste_from_clipboard paste_selection scroll_line_up scroll_line_down
    scroll_page_up scroll_page_down scroll_home scroll_end scroll_to_prompt scroll_to_mark
    new_window new_tab close_window next_tab previous_tab move_tab_forward move_tab_backward
    set_tab_title new_os_window close_os_window clear_screen clear_terminal reset_terminal
    enter_full_screen toggle_full_screen launch url_prefix_command goto_url toggle_maximized
    set_font_size change_font_size set_background_opacity toggle_maximized kitten_launch
    search_regex search_next search_previous show_scrollback show_last_command_output
    edit_config_file edit_config_file_in_editor launch_child_process new_window_with_cwd
  ].freeze

  def initialize(options = {})
    @config_file = options[:config] || CONFIG_FILE
    @output_dir = options[:output] || OUTPUT_DIR
    @dry_run = options[:dry_run] || false
  end

  def run(args)
    command = args.shift || 'generate'

    case command
    when 'generate', 'gen' then generate_config(args)
    when 'dump' then dump_config(args)
    when 'validate' then validate_config(args)
    when 'actions' then list_actions(args)
    when 'import' then import_config(args)
    when 'export' then export_config(args)
    else
      puts "Unknown command: #{command}"
      puts "Use 'kittycmd --help' for usage"
    end
  end

  private

  def generate_config(args)
    input = args[0]

    if input && File.exist?(input)
      generate_from_file(input)
    elsif input && input.end_with?('.yaml')
      generate_from_yaml(input)
    else
      generate_default
    end
  end

  def generate_from_file(file)
    shortcuts = parse_yaml_file(file)
    generate_kitty_conf(shortcuts)
  end

  def generate_from_yaml(yaml_file)
    shortcuts = YAML.safe_load(File.read(yaml_file))
    shortcuts = shortcuts['shortcuts'] || shortcuts
    generate_kitty_conf(shortcuts)
  end

  def generate_default
    puts "Usage: kittycmd generate <shortcuts.yaml>"
    puts "       kittycmd generate (creates default template)"
    puts ""
    puts "Example YAML format:"
    puts <<~YAML
      navigation:
        "ctrl+shift+up": previous_tab
        "ctrl+shift+down": next_tab
        "ctrl+shift+t": new_tab

      clipboard:
        "ctrl+shift+c": copy_to_clipboard
        "ctrl+shift+v": paste_from_clipboard
    YAML
  end

  def parse_yaml_file(file)
    return {} unless File.exist?(file)

    content = YAML.safe_load(File.read(file))
    content['shortcuts'] || content
  rescue => e
    puts "\e[31mError parsing #{file}: #{e.message}\e[0m"
    {}
  end

  def generate_kitty_conf(shortcuts)
    output = []
    output << "# Generated by kittycmd"
    output << "# #{Time.now.strftime('%Y-%m-%d %H:%M')}"
    output << ""

    shortcuts.each do |category, binds|
      output << "# #{category.to_s.capitalize}"
      binds.each do |key, action|
        if valid_action?(action)
          output << "map #{key} #{action}"
        else
          output << "# map #{key} #{action}  # Unknown action"
        end
      end
      output << ""
    end

    if @dry_run
      puts output.join("\n")
    else
      output_file = File.join(@output_dir, 'shortcuts.conf')
      FileUtils.mkdir_p(@output_dir)

      if File.exist?(@config_file)
        # Append to existing config
        existing = File.read(@config_file)
        unless existing.include?('# Generated by kittycmd')
          File.write(@config_file, existing + "\n\n" + output.join("\n"))
          puts "\e[32mAppended to #{@config_file}\e[0m"
        end
      else
        File.write(output_file, output.join("\n"))
        puts "\e[32mGenerated #{output_file}\e[0m"
      end
    end
  end

  def valid_action?(action)
    return false unless action.is_a?(String)

    # Check known actions
    action_name = action.split.first
    KITTY_ACTIONS.include?(action_name) || action_name.start_with?('kitten')
  end

  def dump_config(args)
    output_format = args[0] || 'yaml'

    existing_mappings = parse_kitty_conf

    case output_format
    when 'yaml'
      puts "shortcuts:"
      existing_mappings.each do |category, binds|
        puts "  #{category}:"
        binds.each do |key, action|
          puts "    \"#{key}\": #{action}"
        end
      end
    when 'json'
      puts JSON.pretty_generate({ shortcuts: existing_mappings })
    else
      existing_mappings.each do |category, binds|
        puts "# #{category}"
        binds.each do |key, action|
          puts "map #{key} #{action}"
        end
      end
    end
  end

  def parse_kitty_conf
    return {} unless File.exist?(@config_file)

    content = File.read(@config_file)
    mappings = { 'general' => {} }
    category = 'general'

    content.lines.each do |line|
      line = line.strip

      if line.start_with?('#') && line.match(/^#\s*(\w+)/)
        category = $1.downcase
        mappings[category] ||= {}
      end

      if line.match(/^map\s+(\S+)\s+(.+)$/)
        key = $1
        action = $2
        mappings[category] ||= {}
        mappings[category][key] = action
      end
    end

    mappings.reject { |k, v| v.empty? }
  end

  def validate_config(args)
    return puts "Config file not found: #{@config_file}" unless File.exist?(@config_file)

    puts "Validating #{@config_file}..."

    content = File.read(@config_file)
    errors = []
    warnings = []
    line_num = 0

    content.lines.each do |line|
      line_num += 1
      line = line.strip
      next if line.empty? || line.start_with?('#')

      if line.match(/^map\s+(\S+)\s+(.*)$/)
        key = $1
        action = $2.strip

        # Validate key
        valid_mods = %w[ctrl shift alt super cmd]
        mods_and_key = key.split('+')

        unless mods_and_key.size >= 1
          errors << "Line #{line_num}: Invalid key format: #{key}"
        end

        # Validate action
        action_name = action.split.first
        unless valid_action?(action_name)
          warnings << "Line #{line_num}: Unknown action: #{action_name}"
        end
      end
    end

    if errors.empty? && warnings.empty?
      puts "\e[32m✓ Config is valid\e[0m"
    else
      errors.each { |e| puts "\e[31m✗ #{e}\e[0m" }
      warnings.each { |w| puts "\e[33m? #{w}\e[0m" }
      puts "\n#{errors.size} errors, #{warnings.size} warnings"
    end
  end

  def list_actions(args)
    filter = args[0]

    puts "\e[1mAvailable Kitty actions:\e[0m\n"

    KITTY_ACTIONS.each do |action|
      next if filter && !action.downcase.include?(filter.downcase)
      puts "  #{action}"
    end

    puts "\n\e[90mFor custom commands, use: pass_selection_to_program, launch, etc.\e[0m"
    puts "\e[90mFor kittens, use: kitten <kitten-name>\e[0m"
  end

  def import_config(args)
    source = args[0] || @config_file
    return puts "File not found: #{source}" unless File.exist?(source)

    yaml_output = File.join(@output_dir, 'shortcuts.yaml')
    mappings = parse_kitty_conf

    File.write(yaml_output, YAML.dump({ 'shortcuts' => mappings }))
    puts "\e[32mExported to #{yaml_output}\e[0m"
  end

  def export_config(args)
    format = args[0] || 'yaml'
    output_file = args[1] || File.join(@output_dir, "shortcuts.#{format}")

    mappings = parse_kitty_conf

    case format
    when 'yaml'
      File.write(output_file, YAML.dump({ 'shortcuts' => mappings }))
    when 'json'
      File.write(output_file, JSON.pretty_generate({ shortcuts: mappings }))
    else
      File.write(output_file, mappings.inspect)
    end

    puts "\e[32mExported to #{output_file}\e[0m"
  end
end

OptionParser.new do |opts|
  opts.banner = "Usage: kittycmd <command> [options]"
  opts.on('-c', '--config FILE', 'Config file path') { |v| options[:config] = v }
  opts.on('-o', '--output DIR', 'Output directory') { |v| options[:output] = v }
  opts.on('--dry-run', 'Preview without changes') { options[:dry_run] = true }
  opts.on('-h', '--help', 'Show help') { puts opts; exit }
end.parse!

Kittycmd.new(ARGV).run(ARGV)