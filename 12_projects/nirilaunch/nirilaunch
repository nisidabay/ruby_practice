#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'yaml'
require 'fileutils'

class Nirilaunch
  DESKTOP_DIRS = [
    '/usr/share/applications',
    '/usr/local/share/applications',
    File.expand_path('~/.local/share/applications')
  ].freeze

  CONFIG_DIR = File.expand_path('~/.config/nirilaunch')
  CACHE_FILE = File.join(CONFIG_DIR, 'apps.cache')

  def initialize(options = {})
    @config_dir = CONFIG_DIR
    @cache_file = CACHE_FILE
    @output = options[:output] || 'kdl'
    @launcher = options[:launcher] || 'fuzzel'
    FileUtils.mkdir_p(@config_dir)
    @apps = []
  end

  def run(args)
    command = args.shift || 'scan'

    case command
    when 'scan' then scan_apps(args)
    when 'generate', 'gen' then generate_config(args)
    when 'bind' then generate_bind(args)
    when 'toggle' then generate_toggle(args)
    when 'list', 'ls' then list_apps(args)
    when 'search' then search_apps(args)
    when 'export' then export_config(args)
    else
      puts "Unknown command: #{command}"
      puts "Use 'nirilaunch --help' for usage"
    end
  end

  private

  def load_cache
    return [] unless File.exist?(@cache_file)
    YAML.safe_load(File.read(@cache_file), permitted_classes: [Date, Time]) || []
  rescue
    []
  end

  def save_cache
    File.write(@cache_file, YAML.dump(@apps))
  end

  def scan_apps(args)
    puts "\e[1mScanning desktop entries...\e[0m"

    @apps = []

    DESKTOP_DIRS.each do |dir|
      next unless File.directory?(dir)

      Dir.glob(File.join(dir, '*.desktop')).each do |file|
        app = parse_desktop_file(file)
        @apps << app if app && app[:name]
      end
    end

    @apps.uniq! { |a| a[:name] }
    @apps.sort_by! { |a| a[:name].downcase }

    save_cache
    puts "\e[32mFound #{@apps.size} applications\e[0m"
  end

  def parse_desktop_file(file)
    content = File.read(file)
    app = { file: file }

    content.lines.each do |line|
      case line
      when /^Name=(.+)$/ then app[:name] = $1.strip
      when /^Name\[(\w+)\]=(.+)$/ then (app[:names] ||= {})[$1] = $2.strip
      when /^Exec=(.+)$/ then app[:exec] = parse_exec($1.strip)
      when /^Icon=(.+)$/ then app[:icon] = $1.strip
      when /^Categories=(.+)$/ then app[:categories] = $1.strip.split(';').reject(&:empty?)
      when /^Comment=(.+)$/ then app[:comment] = $1.strip
      when /^Terminal=(true|false)$/ then app[:terminal] = $1 == 'true'
      when /^NoDisplay=(true|false)$/ then app[:nodisplay] = $1 == 'true'
      end
    end

    return nil if app[:nodisplay]
    app
  end

  def parse_exec(exec_str)
    # Remove field codes like %f, %u, %%
    exec_str
      .gsub(/%[fFuUdDnNickvm]%?/, '')
      .gsub(/%%/, '%')
      .strip
  end

  def list_apps(args)
    @apps = load_cache if @apps.empty?
    filter = args[0]

    apps = @apps.dup
    apps = apps.select { |a| a[:name]&.downcase&.include?(filter&.downcase) } if filter

    apps.each do |app|
      name = app[:name]&.first(30)
      categories = app[:categories]&.join(', ')&.first(20)
      puts "#{name.ljust(32)} \e[90m#{categories}\e[0m"
    end

    puts "\n\e[90m#{apps.size} apps#{filter ? " matching '#{filter}'" : ''}\e[0m"
  end

  def search_apps(args)
    query = args[0]
    return puts "Usage: nirilaunch search <query>" unless query

    @apps = load_cache if @apps.empty?

    matches = @apps.select do |app|
      app[:name]&.downcase&.include?(query.downcase) ||
      app[:categories]&.any? { |c| c.downcase.include?(query.downcase) }
    end

    matches.each do |app|
      puts "#{app[:name]}: #{app[:exec]}"
    end

    puts "\n\e[90m#{matches.size} matches\e[0m" if matches.size > 0
  end

  def generate_config(args)
    @apps = load_cache if @apps.empty?
    template = args[0] || 'default'

    case @output
    when 'kdl'
      generate_kdl(template)
    when 'yaml'
      generate_yaml(template)
    when 'sh'
      generate_script(template)
    else
      generate_kdl(template)
    end
  end

  def generate_kdl(template)
    puts "// Generated by nirilaunch"
    puts "// Template: #{template}"
    puts ""
    puts "binds {"

    common_apps = @apps.select do |app|
      %w[terminal browser editor file-manager].any? { |c| app[:categories]&.include?(c) }
    end

    bind_apps = @apps.first(10)

    bind_apps.each_with_index do |app, idx|
      key = get_bind_key(idx)
      exec = app[:exec]&.split&.first || ''
      puts "  Mod+#{key} { spawn \"#{exec}\"; }"
    end

    puts "}"
  end

  def generate_yaml(template)
    puts "apps:"

    @apps.first(20).each do |app|
      puts "  - name: #{app[:name]}"
      puts "    exec: #{app[:exec]}"
      puts "    icon: #{app[:icon]}"
      puts "    categories: #{app[:categories]&.join(', ')}"
    end
  end

  def generate_script(template)
    puts "#!/bin/bash"
    puts "# Generated by nirilaunch"

    @apps.first(10).each_with_index do |app, idx|
      key = get_bind_key(idx)
      puts "# Super+#{key}: #{app[:name]}"
    end

    puts ""
    puts "# Usage: source this file or add binds to your niri config"
  end

  def get_bind_key(idx)
    keys = %w[Return q w e r t y u i o p a s d f g h j k l z x c v b n m]
    keys[idx] || (idx + 1).to_s
  end

  def generate_bind(args)
    app_name = args[0]
    key = args[1]

    return "Usage: nirilaunch bind <app> <key>" unless app_name

    @apps = load_cache if @apps.empty?

    app = @apps.find { |a| a[:name]&.downcase == app_name.downcase }
    return puts "\e[31mApp not found: #{app_name}\e[0m" unless app

    exec = app[:exec]&.split&.first || ''
    key = key&.upcase || 'Return'

    puts "// #{app[:name]}"
    puts "binds {"
    puts "  Mod+#{key} { spawn \"#{exec}\"; }"
    puts "}"
  end

  def generate_toggle(args)
    app_name = args[0]
    return "Usage: nirilaunch toggle <app>" unless app_name

    @apps = load_cache if @apps.empty?

    app = @apps.find { |a| a[:name]&.downcase&.include?(app_name.downcase) }
    return puts "\e[31mApp not found: #{app_name}\e[0m" unless app

    exec = app[:exec]&.split&.first || ''

    puts "// Toggle #{app[:name]}"
    puts "spawn-or-focus \"#{exec}\""
    puts "// For more complex toggling, use a script:"
    puts "// #!/bin/sh"
    puts "// if pgrep -x #{exec} > /dev/null; then"
    puts "//   pkill -x #{exec}"
    puts "// else"
    puts "//   exec #{exec}"
    puts "// fi"
  end

  def export_config(args)
    format = args[0] || 'yaml'
    output_file = args[1] || File.join(@config_dir, "apps.#{format}")

    @apps = load_cache if @apps.empty?

    case format
    when 'yaml'
      File.write(output_file, YAML.dump(@apps))
    when 'json'
      File.write(output_file, JSON.pretty_generate(@apps))
    else
      puts "Unknown format: #{format}. Use: yaml, json"
      return
    end

    puts "\e[32mExported to #{output_file}\e[0m"
  end
end

OptionParser.new do |opts|
  opts.banner = "Usage: nirilaunch <command> [options]"
  opts.on('-o', '--output FORMAT', 'Output format: kdl, yaml, sh') { |v| options[:output] = v }
  opts.on('-l', '--launcher NAME', 'Launcher: fuzzel, rofi') { |v| options[:launcher] = v }
  opts.on('-h', '--help', 'Show help') { puts opts; exit }
end.parse!

Nirilaunch.new(ARGV).run(ARGV)