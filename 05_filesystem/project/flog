#!/usr/bin/env ruby
# frozen_string_literal: true

# flog — log file rotator and archiver
#
# WITHOUT a rotation tool — logs grow forever, disk fills, services crash:
#   /var/log/app.log → 50GB → "No space left on device"
#   Manual deletion at 3am = pain
#
# WITH flog — scheduled rotation, compressed archives, disk reclaimed:
#   flog --dir /var/log/app --size 10MB --compress

require 'optparse'
require 'find'
require 'fileutils'

options = {
  dir: '.',
  size: 10 * 1024 * 1024,  # 10MB default
  compress: false,
  dry_run: false
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: flog [options]"
  opts.on("-d", "--dir DIR", "Directory to scan") { |d| options[:dir] = d }
  opts.on("-s", "--size BYTES", Integer, "Rotate files larger than this") { |n| options[:size] = n }
  opts.on("-z", "--compress", "Compress old logs with gzip") { options[:compress] = true }
  opts.on("--dry-run", "Show what would be done, don't change anything") { options[:dry_run] = true }
  opts.on("-h", "--help") { puts opts; exit }
end.parse!

abort "flog: #{options[:dir]} not found" unless File.directory?(options[:dir])

rotated = 0
Find.find(options[:dir]) do |path|
  begin
    stat = File.lstat(path)
  rescue Errno::ENOENT, Errno::EACCES
    next
  end

  next unless stat.file?
  next unless stat.size > options[:size]

  rotated += 1
  target = "#{path}.#{Time.now.strftime('%Y%m%d_%H%M%S')}"

  if options[:dry_run]
    puts "[DRY-RUN] Would rotate: #{path} (#{stat.size} bytes)"
  else
    FileUtils.cp(path, target, preserve: true)
    File.truncate(path, 0)
    puts "Rotated: #{path} -> #{target}"
  end

  if options[:compress] && !options[:dry_run]
    system("gzip", target)
    puts "Compressed: #{target}.gz"
  elsif options[:compress]
    puts "[DRY-RUN] Would compress: #{target}.gz"
  end
end

puts "#{options[:dry_run] ? 'Would rotate' : 'Rotated'} #{rotated} file(s)."
