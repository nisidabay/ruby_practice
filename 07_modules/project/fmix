#!/usr/bin/env ruby
# frozen_string_literal: true

# fmix — configurable CLI built from mixin modules
#
# WITHOUT modules — every feature is copy-pasted, no isolation:
#   class CLI
#     def verbose?; @verbose; end      # copy-paste into every class
#     def handle_error(e); ...; end      # copy-paste into every class
#     def log(msg); ...; end             # copy-paste into every class
#
# WITH modules — one module per concern, mix into any class:
#   class Fmix < Thor; include Logging, ErrorHandling, Verbosity; end

require 'optparse'

module Logging
  def log(msg)
    puts "[LOG] #{Time.now.strftime('%H:%M:%S')} #{msg}"
  end
end

module ColorOutput
  COLORS = { red: 31, green: 32, yellow: 33, blue: 34 }.freeze

  def colorize(text, color)
    code = COLORS[color] || 0
    "\033[#{code}m#{text}\033[0m"
  end
end

module SizeFormat
  def human_size(bytes)
    return "0 B" if bytes.zero?
    units = %w[B KB MB GB TB]
    exp = (Math.log(bytes) / Math.log(1024)).to_i
    exp = units.size - 1 if exp >= units.size
    format("%.1f %s", bytes.to_f / (1024 ** exp), units[exp])
  end
end

class Fmix
  include Logging
  include ColorOutput
  include SizeFormat

  def run(args)
    options = {}

    parser = OptionParser.new do |opts|
      opts.banner = "Usage: fmix [options] <path>"
      opts.on("-v", "--verbose", "Verbose output") { options[:verbose] = true }
      opts.on("-c", "--color", "Colorized output") { options[:color] = true }
      opts.on("-h", "--help") { puts opts; exit }
    end.parse!(args)

    path = args[0] || "."
    abort(colorize("Not found: #{path}", :red)) unless File.exist?(path)

    log("Scanning #{path}") if options[:verbose]

    size = File.size(path) rescue 0
    msg = "#{path}: #{human_size(size)}"

    if options[:color]
      puts colorize(msg, size > 1024 * 1024 ? :yellow : :green)
    else
      puts msg
    end
  end
end

Fmix.new.run(ARGV)
